# Server port (Railway will override this automatically)
PORT=3000

# SQLite database path (relative to project root)
DB_PATH=./data/mock.db

# Mock token secret (any string, used to generate fake tokens)
MOCK_TOKEN_SECRET=dev-secret-1234

# Set to "true" to log all raw AT command payloads
DEBUG_VERBOSE=false

# Public base URL the device uses to download OTA images. The firmware always
# downloads over HTTPS:443, so this must be the externally reachable HTTPS host
# (behind nginx on the VPS). If unset, it falls back to the request's own host.
PUBLIC_BASE_URL=https://mock-jihan.ddns.net
